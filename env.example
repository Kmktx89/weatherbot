# weatherbot environment — copy to .env and fill in the real values.
#   cp env.example .env    (then edit .env; .env is gitignored)
#
# NOTE: this template is named env.example (no leading dot) on purpose — the
# global permission deny-rule blocks writing any .env* file, so .env / .env.*
# must be created by hand. Claude cannot write them.

# Notification transport for scheduled pushes: telegram | pushover
# Default (unset) = pushover, so leaving this out keeps the legacy behavior.
NOTIFIER=telegram

# Telegram bot credentials (two-way bot + scheduled push).
#  - TELEGRAM_BOT_TOKEN: from @BotFather (/newbot) — looks like 123456789:AA...
#  - TELEGRAM_CHAT_ID: your chat/user id — message the bot once, then GET
#    https://api.telegram.org/bot<token>/getUpdates and read result[].message.chat.id
TELEGRAM_BOT_TOKEN=REPLACE_WITH_BOTFATHER_TOKEN
TELEGRAM_CHAT_ID=REPLACE_WITH_YOUR_CHAT_ID
